# Backend server
NODE_ENV=development
PORT=3000

# App URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000

# Database
DB_URL=mongodb://127.0.0.1:27017/smart-career-counselling

# Authentication/OAuth
JWT_SECRET_TOKEN=replace_with_strong_jwt_secret
GITHUB_CLIENT_KEY=your_github_client_id
GITHUB_SECRET_CLIENT_KEY=your_github_client_secret
GOOGLE_CLIENT_KEY=your_google_client_id
GOOGLE_SECRET_CLIENT_KEY=your_google_client_secret

# Mail (Resend)
RESEND_API_KEY=your_resend_api_key

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ML API
ML_API_BASE_URL=http://127.0.0.1:8000

# Inngest (optional unless you use Inngest workflows)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Groq AI (set one of these)
GROQ_API_KEY=
GROQ_SECRET_API_KEY=
